{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://naviz-backend-staging.up.railway.app/$1"
    },
    {
      "src": "/socket.io/(.*)",
      "dest": "https://naviz-backend-staging.up.railway.app/socket.io/$1"
    },
    {
      "src": "/(.*\\.[a-zA-Z0-9]+)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "framework": "vite",
  "regions": ["iad1"]
}
